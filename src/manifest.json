{
  "manifest_version": 3,
  "name": "Time Limiter for Instagram",
  "version": "1.3.0",
  "description": "Shared daily time limit and curfew for Instagram and X, with a friendly reminder once time is up. Password-protected.",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": ["*://*.instagram.com/*", "*://*.x.com/*", "*://*.twitter.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Time Limiter for Instagram",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
